<svg xmlns="http://www.w3.org/2000/svg" width="120" height="40" viewBox="0 0 120 40">
  <defs>
    <linearGradient id="logoGradient" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" style="stop-color:#5ec576;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#9be15d;stop-opacity:1" />
    </linearGradient>
  </defs>
  
  <!-- Background circle -->
  <circle cx="20" cy="20" r="18" fill="url(#logoGradient)" />
  
  <!-- Bank icon inside circle -->
  <rect x="12" y="15" width="16" height="10" fill="white" rx="1"/>
  <rect x="14" y="12" width="12" height="2" fill="white" rx="1"/>
  <rect x="16" y="9" width="8" height="2" fill="white" rx="1"/>
  <line x1="12" y1="26" x2="28" y2="26" stroke="white" stroke-width="1"/>
  
  <!-- Text -->
  <text x="45" y="25" font-family="Arial, sans-serif" font-size="16" font-weight="bold" fill="#333">
    Bankist
  </text>
</svg>