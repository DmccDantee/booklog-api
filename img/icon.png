<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 32 32">
  <defs>
    <linearGradient id="iconGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#5ec576;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#9be15d;stop-opacity:1" />
    </linearGradient>
  </defs>
  
  <!-- Background -->
  <rect width="32" height="32" rx="6" fill="url(#iconGradient)"/>
  
  <!-- Bank building -->
  <rect x="8" y="18" width="16" height="8" fill="white" rx="1"/>
  <rect x="10" y="15" width="12" height="2" fill="white" rx="1"/>
  <rect x="12" y="12" width="8" height="2" fill="white" rx="1"/>
  <line x1="8" y1="27" x2="24" y2="27" stroke="white" stroke-width="1"/>
  
  <!-- Pillars -->
  <rect x="11" y="19" width="1" height="5" fill="url(#iconGradient)"/>
  <rect x="15" y="19" width="1" height="5" fill="url(#iconGradient)"/>
  <rect x="19" y="19" width="1" height="5" fill="url(#iconGradient)"/>
</svg>